# ── Application ──────────────────────────────────────────────
APP_NAME=llm-gateway
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_REQUEST_TIMEOUT_SECONDS=30

# ── Cloud provider (config-driven; one class for all cloud APIs) ──
CLOUD_PROVIDER_API_KEY=your-api-key-here
CLOUD_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CLOUD_PROVIDER_MODEL=gemini-1.5-flash
CLOUD_PROVIDER_TIMEOUT_SECONDS=15
CLOUD_PROVIDER_MAX_RETRIES=3

# ── Cache (Phase 2 — semantic cache) ─────────────────────────
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_TTL_SECONDS=86400
